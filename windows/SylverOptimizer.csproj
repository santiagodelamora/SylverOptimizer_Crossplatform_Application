<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SylverOptimizer</AssemblyName>
    <Product>SylverOptimizer</Product>
    <Version>1.0.0</Version>
    <Authors>Santiago De la Mora</Authors>
    <Description>Optimizador de RAM, Caché y Monitor de CPU para Windows 11</Description>
    <Copyright>Copyright (C) 2026 Santiago De la Mora</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
